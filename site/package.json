{
  "name": "higedan-setlist-site",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-data.mjs",
    "lint": "oxlint src -c .oxlintrc.json",
    "check:i18n": "node scripts/check-i18n.mjs --self-test && node scripts/check-i18n.mjs",
    "check-i18n": "pnpm check:i18n",
    "test": "pnpm sync && node scripts/check-i18n.mjs && node scripts/smoke-test.mjs",
    "test:pipeline": "node --test \"tests/pipeline/**/*.test.js\"",
    "test:invariants": "node --test \"tests/invariants/**/*.test.js\"",
    "test:ui": "node --test \"tests/ui/**/*.test.js\"",
    "check": "pnpm lint && pnpm test",
    "check:fast": "oxlint src -c .oxlintrc.json && node scripts/check-i18n.mjs",
    "audit:reports": "node scripts/generate-audit-reports.mjs",
    "eval": "node scripts/eval.mjs",
    "generate:icons": "node scripts/generate-icons.mjs",
    "dev": "pnpm sync && vite",
    "build": "pnpm sync && vite build",
    "preview": "pnpm sync && vite preview"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
